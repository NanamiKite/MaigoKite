{
  "name": "maigokite-web",
  "productName": "MaigoKite",
  "private": true,
  "version": "0.1.0",
  "license": "MPL-2.0",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "build": {
    "appId": "com.electron.maigokite-web",
    "icon": "public/brand/app-icon-cat-ribbon-v1.png"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/lib/web-build.cjs desktop",
    "build:web": "node ../scripts/lib/web-build.cjs web",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.ts,.tsx --max-warnings=0",
    "lint:check": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "electron:dev": "node ../scripts/local.cjs start desktop dev",
    "electron:compile": "node ../scripts/lib/web-build.cjs electron",
    "electron:install": "node --use-env-proxy node_modules/electron/install.js",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "node ../scripts/local.cjs start desktop built",
    "test:run": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "markdown-it": "14.1.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-i18n": "11.4.14",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "openapi-typescript": "^7.10.1",
    "@types/node": "^24.9.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.1.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "tree-kill": "^1.2.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.1.0",
    "vue-tsc": "^2.2.12",
    "wait-on": "^7.2.0"
  }
}
